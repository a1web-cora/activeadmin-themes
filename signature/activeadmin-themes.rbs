# signature/activeadmin-themes.rbs

module ActiveAdmin
  module Themes
    VERSION: String

    def self.registry: () -> Registry

    class InstallationPlan
      class UnsafePath < ArgumentError
      end

      def initialize: (root: String, theme: Theme, active_admin_version: String, files: Hash[String, String]) -> void
      def status: () -> Hash[String, (:missing | :identical | :modified)]
      def installable?: () -> bool
    end

    class Theme < Data
      attr_reader key: Symbol
      attr_reader name: String
      attr_reader description: String
      attr_reader active_admin_requirement: Gem::Requirement
      attr_reader recipe_version: String

      def supports?: (String | Gem::Version version) -> bool
    end

    class Registry
      include Enumerable[Theme]

      def initialize: () -> void
      def each: () { (Theme) -> void } -> untyped
      def fetch: (String | Symbol key) -> Theme
      def register: (Theme theme) -> self
      def keys: () -> Array[Symbol]
    end
  end
end
